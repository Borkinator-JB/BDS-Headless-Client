<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <EditText android:id="@+id/gamertag" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:hint="@string/gamertag" android:inputType="text" />
    <com.google.android.material.button.MaterialButton android:id="@+id/add" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/add" />
  </LinearLayout>

  <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/auto_accept"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auto_accept" />

  <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="#C62828" android:visibility="gone" />

  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="8dp" android:text="@string/requests" android:textStyle="bold" />
  <ListView android:id="@+id/requests" android:layout_width="match_parent" android:layout_height="0dp"
      android:layout_weight="1" />

  <TextView android:id="@+id/friends_title" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="8dp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/friends_hint" />
  <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
      android:layout_weight="3" />
</LinearLayout>
