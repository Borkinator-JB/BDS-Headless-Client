[Unit]
Description=BDS Headless Client
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=bdsheadless
Group=bdsheadless
# At boot this only passes when "Start at boot" is on. Manual starts always pass.
ExecCondition=/opt/bds-headless/autostart-check.sh
ExecStart=/opt/bds-headless/bds-headless-service
StateDirectory=bds-headless
StateDirectoryMode=0700
Environment=HOME=/var/lib/bds-headless
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
